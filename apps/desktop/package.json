{
  "name": "@layup/desktop",
  "version": "0.3.0",
  "private": true,
  "description": "Layup Electron desktop client.",
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "tsc -p tsconfig.node.json",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder --mac --universal -c.extraMetadata.layupCommit=\"$(git rev-parse --short HEAD 2>/dev/null || echo dev)\" -c.extraMetadata.layupBuiltAt=\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.preload.json && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:boundary": "electron test/boundary/main.cjs",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "build:webrtc": "vite build --config vite.webrtc.config.ts",
    "test:webrtc": "npm run build:webrtc && electron test/webrtc/main.cjs"
  },
  "dependencies": {
    "@layup/protocol": "*",
    "electron-updater": "^6.8.9",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "jsdom": "27.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
