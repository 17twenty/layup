LAYUP_LISTEN_ADDR=127.0.0.1:8787
# NOT dev. "dev" makes the server believe X-Layup-Dev-User from anyone,
# anywhere (services/control/internal/httpapi/auth.go), and this file is
# copied verbatim onto a public box. Since identities are now real and
# GET /api/directory publishes their ids, that header would impersonate an
# actual person rather than a fixture.
LAYUP_ENV=selfhosted
LAYUP_LOG_LEVEL=info
LAYUP_LOG_FORMAT=json

# The shared secret that lets someone join this server, and the only thing
# this service persists (identities and their tokens). Both must be set for
# registration to work at all; with either missing the server accepts nobody.
# Pick something unguessable: openssl rand -hex 4, prefixed.
LAYUP_JOIN_CODE=REPLACE_ME
LAYUP_STATE_DIR=/var/lib/layup

# openssl rand -hex 32 - shared with coturn's static-auth-secret.
LAYUP_TURN_SECRET=REPLACE_ME

LAYUP_TURN_URLS=turn:layup.blah.au:3478?transport=udp
LAYUP_STUN_URLS=stun:layup.blah.au:3478

# Set true only to prove the relay path end to end.
LAYUP_FORCE_RELAY=false
